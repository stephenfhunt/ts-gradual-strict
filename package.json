{
  "name": "ts-gradual-strict",
  "version": "0.0.0",
  "description": "Check `/** @strict */`-marked TypeScript under strictNullChecks, one declaration at a time, in a project that is not strict yet.",
  "type": "module",
  "private": true,
  "license": "ISC",
  "bin": {
    "ts-gradual-strict": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "typescript": ">=5.0 <7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.4",
    "fast-check": "^4.10.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
