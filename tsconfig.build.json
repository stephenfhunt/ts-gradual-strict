{
  // The distribution: an emit overlay on tsconfig.json over `src/` alone.
  // `rewriteRelativeImportExtensions` turns the `.ts` specifiers in `src/` into `.js`, so the
  // source stays runnable under Node's type stripping and the emitted CLI still resolves.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rewriteRelativeImportExtensions": true,
    "declaration": true,
    "sourceMap": true,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src"],
  "exclude": []
}
